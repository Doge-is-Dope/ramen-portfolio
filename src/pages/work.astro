---
import SiteFooter from "@/components/SiteFooter.astro";
import TopBar from "@/components/TopBar.astro";
import WorkFilterBar from "@/components/WorkFilterBar.astro";
import WorkRow from "@/components/WorkRow.astro";
import { work } from "@/data/work";
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/work.css";

const title = "RAMEN Selected Work";
const description =
	"Selected RAMEN project work by Clement Liang across agent architecture, streaming, browser automation, chat UX, and delivery quality.";
---

<BaseLayout title={title} description={description}>
  <TopBar activePage="selectedWork" />

  <main id="main-content" class="work-page">
    <header class="work-page__hero">
      <h1 class="work-page__title">Selected Work</h1>
      <p class="work-page__dek">
        A curated index of the architecture, agent, streaming, browser, and
        chat UI work behind RAMEN.
      </p>
    </header>

    <WorkFilterBar />

    <ol class="work-list" data-filter="all">
      {work.map((entry) => <WorkRow entry={entry} />)}
      <li class="work-list__empty">No entries in this category.</li>
    </ol>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  let abortController: AbortController | null = null;

  function setupWorkPage() {
    abortController?.abort();
    abortController = new AbortController();
    const signal = abortController.signal;

    const list = document.querySelector<HTMLOListElement>(".work-list");
    if (!list) return;

    const filterChips = document.querySelectorAll<HTMLButtonElement>(
      ".work-filter__chip",
    );
    const filterScroller =
      document.querySelector<HTMLDivElement>(".work-filter");
    const workRows = Array.from(
      list.querySelectorAll<HTMLLIElement>(".work-row"),
    );

    const applyFilter = (slug: string) => {
      list.dataset.filter = slug;
      if (slug === "all") return;
      for (const row of workRows) {
        row.toggleAttribute(
          "data-category-match",
          row.dataset.category === slug,
        );
      }
    };

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );

    for (const chip of filterChips) {
      chip.addEventListener(
        "click",
        () => {
          const slug = chip.dataset.filterTarget ?? "all";
          for (const other of filterChips) {
            other.setAttribute(
              "aria-pressed",
              other === chip ? "true" : "false",
            );
          }
          applyFilter(slug);
          chip.scrollIntoView({
            inline: "nearest",
            block: "nearest",
            behavior: reduceMotion.matches ? "auto" : "smooth",
          });
        },
        { signal },
      );
    }

    if (filterScroller) {
      let filterFrame = 0;
      const updateFilterScrollPosition = () => {
        filterFrame = 0;
        const maxScroll =
          filterScroller.scrollWidth - filterScroller.clientWidth;
        if (maxScroll <= 1) {
          filterScroller.dataset.filterScrollPosition = "none";
          return;
        }
        if (filterScroller.scrollLeft <= 1) {
          filterScroller.dataset.filterScrollPosition = "start";
        } else if (filterScroller.scrollLeft >= maxScroll - 1) {
          filterScroller.dataset.filterScrollPosition = "end";
        } else {
          filterScroller.dataset.filterScrollPosition = "middle";
        }
      };
      const scheduleFilterScrollPosition = () => {
        if (filterFrame) return;
        filterFrame = window.requestAnimationFrame(updateFilterScrollPosition);
      };
      filterScroller.addEventListener("scroll", scheduleFilterScrollPosition, {
        passive: true,
        signal,
      });
      window.addEventListener("resize", scheduleFilterScrollPosition, {
        signal,
      });
      signal.addEventListener("abort", () => {
        if (filterFrame) cancelAnimationFrame(filterFrame);
      });
      updateFilterScrollPosition();
    }

  }

  document.addEventListener("astro:page-load", setupWorkPage);
</script>
