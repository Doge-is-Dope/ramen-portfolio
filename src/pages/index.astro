---
import ArticleBody from "@/components/ArticleBody.astro";
import ArticleHero from "@/components/ArticleHero.astro";
import ArticleNavigationRail from "@/components/ArticleNavigationRail.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import TopBar from "@/components/TopBar.astro";
import { sections } from "@/data/article";
import { profile } from "@/data/profile";
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "RAMEN Case Study";
const description =
	"How I built RAMEN as the founding engineer, an enterprise platform for browser-capable agents, from an empty repository to production.";
---

<BaseLayout title={title} description={description}>
  <TopBar />

  <main id="main-content" class="article-shell">
    <ArticleHero profile={profile} />
    <ArticleNavigationRail sections={sections} />
    <ArticleBody sections={sections} />
  </main>

  <SiteFooter />
</BaseLayout>
