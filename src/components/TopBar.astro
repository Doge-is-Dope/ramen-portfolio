---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { withBase } from "@/lib/url";
---

<header class="top-bar">
  <div class="top-bar__blur" aria-hidden="true">
    <div></div>
    <div></div>
    <div></div>
    <div></div>
  </div>
  <div class="top-bar__inner">
    <a
      class="top-bar__name wordmark-shimmer"
      href={withBase("/")}
      data-text="RAMEN"
      aria-label="RAMEN home"
    >RAMEN</a>
    <ThemeToggle />
  </div>
</header>

<style>
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .top-bar__blur {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: calc(100% + var(--space-12));
    z-index: -1;
    pointer-events: none;
    /* Heavier dimming carries the fade so blur radii can stay low,
       which keeps text passing underneath from looking bolder. */
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 94%, transparent) 0%,
      color-mix(in srgb, var(--bg) 80%, transparent) 38%,
      color-mix(in srgb, var(--bg) 44%, transparent) 66%,
      transparent 88%
    );
  }

  .top-bar__blur > div {
    position: absolute;
    inset: 0;
    --m1: 0%;
    --m2: 0%;
    --falloff: linear-gradient(
      to bottom,
      transparent var(--m1),
      #000 var(--m2),
      #000 var(--m3),
      transparent var(--m4)
    );
    -webkit-backdrop-filter: blur(var(--b));
    backdrop-filter: blur(var(--b));
    -webkit-mask-image: var(--falloff);
    mask-image: var(--falloff);
  }

  /* 4 layers, low max blur, small increments for a smooth ramp */
  .top-bar__blur > div:nth-child(1) {
    --b: 1px;
    --m3: 74%;
    --m4: 90%;
  }
  .top-bar__blur > div:nth-child(2) {
    --b: 3px;
    --m3: 52%;
    --m4: 76%;
  }
  .top-bar__blur > div:nth-child(3) {
    --b: 6px;
    --m3: 30%;
    --m4: 56%;
  }
  .top-bar__blur > div:nth-child(4) {
    --b: 10px;
    --m3: 14%;
    --m4: 36%;
  }

  .top-bar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--measure-shell);
    margin: 0 auto;
    padding: var(--space-4) var(--space-gutter);
    font-size: var(--fs-meta);
    font-weight: var(--fw-medium);
    color: var(--muted);
  }

  .top-bar__name {
    color: var(--fg);
    text-decoration: none;
  }

  .top-bar__name:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }

  @media (max-width: 640px), (hover: none) and (pointer: coarse) {
    .top-bar__blur > div:nth-child(n + 2) {
      display: none;
    }

    .top-bar__blur > div:nth-child(1) {
      --b: 6px;
      --m3: 52%;
      --m4: 100%;
    }
  }

  @media (max-width: 640px) {
    .top-bar__inner {
      padding-inline: var(--space-4);
    }

    .top-bar__name {
      white-space: nowrap;
    }
  }
</style>

<script>
  import { initOnce } from "@/lib/init-once";
  import { bindHoverShimmer } from "@/lib/wordmark-shimmer";

  const setupWordmarkShimmer = () => {
    bindHoverShimmer(document.querySelector<HTMLElement>(".top-bar__name"));
  };

  // Exponential smoothing (not a timed curve): each frame moves a fraction of
  // the distance left, so it settles like a damped object. The dt term keeps it
  // frame-rate independent; DECAY is the feel knob.
  const scrollToTop = () => {
    if (window.scrollY <= 0) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      window.scrollTo(0, 0);
      return;
    }
    const DECAY = 7;
    const handoff = new AbortController();
    let raf = 0;
    const stop = () => {
      cancelAnimationFrame(raf);
      handoff.abort();
    };
    for (const evt of ["wheel", "touchstart", "keydown"]) {
      window.addEventListener(evt, stop, {
        signal: handoff.signal,
        passive: true,
      });
    }
    let current = window.scrollY;
    let last = 0;
    const step = (now: number) => {
      if (last) current *= Math.exp((-DECAY * (now - last)) / 1000);
      last = now;
      if (current < 0.5) {
        window.scrollTo(0, 0);
        handoff.abort();
        return;
      }
      window.scrollTo(0, current);
      raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  };

  const setupSamePageScroll = () => {
    const bar = document.querySelector<HTMLElement>(".top-bar");
    if (!bar || bar.dataset.samePageScrollBound) return;
    bar.dataset.samePageScrollBound = "true";

    bar.addEventListener("click", (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>(
        ".top-bar__name",
      );
      if (!link) return;

      const href = link.getAttribute("href");
      if (!href) return;
      const target = new URL(href, window.location.href);
      if (target.pathname !== window.location.pathname) return;

      event.preventDefault();
      scrollToTop();

      // Drop any anchor if scrolling to the top.
      if (window.location.hash) {
        window.history.replaceState(
          window.history.state,
          "",
          window.location.pathname + window.location.search,
        );
      }
    });
  };

  initOnce("wordmarkShimmer", () => {
    document.addEventListener("astro:page-load", setupWordmarkShimmer);
    document.addEventListener("astro:page-load", setupSamePageScroll);
  });
  setupWordmarkShimmer();
  setupSamePageScroll();
</script>
