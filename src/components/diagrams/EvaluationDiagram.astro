---
import DiagramFrame from "./DiagramFrame.astro";

type Props = { caption: string };
const { caption } = Astro.props;
---

<DiagramFrame caption={caption} label="Learn from failures, then verify fixes — scroll horizontally on smaller screens">
  <svg class="diagram" viewBox="0 0 640 204" role="img" aria-labelledby="ev-title ev-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="ev-title">Learn from failures, then verify fixes</title>
    <desc id="ev-desc">Real traces become scored cases. Fixes address prompts, runtime contracts and browser execution. Verification reruns affected cases and then the full suite; regressions return to the fix stage.</desc>
    <defs>
      <marker id="ev-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M1,1 L9,5 L1,9" class="diagram__arrowhead" />
      </marker>
    </defs>
    <rect x="8" y="40" width="132" height="72" rx="8" class="diagram__node" />
    <text x="74.0" y="70" class="diagram__node-title">Observe</text>
    <text x="74.0" y="93" class="diagram__node-sub">Real traces</text>
    <rect x="172" y="40" width="132" height="72" rx="8" class="diagram__node" />
    <text x="238.0" y="70" class="diagram__node-title">Score</text>
    <text x="238.0" y="93" class="diagram__node-sub">26 cases</text>
    <rect x="336" y="40" width="132" height="72" rx="8" class="diagram__node" />
    <text x="402.0" y="70" class="diagram__node-title">Fix</text>
    <text x="402.0" y="93" class="diagram__node-sub">Prompt / runtime</text>
    <rect x="500" y="40" width="132" height="72" rx="8" class="diagram__node" />
    <text x="566.0" y="70" class="diagram__node-title">Verify</text>
    <text x="566.0" y="93" class="diagram__node-sub">Cases → full suite</text>
    <path d="M148 76 H164" class="diagram__link"  marker-end="url(#ev-arrow)" />
    <path d="M312 76 H328" class="diagram__link"  marker-end="url(#ev-arrow)" />
    <path d="M476 76 H492" class="diagram__link"  marker-end="url(#ev-arrow)" />
    <path d="M566 120 V160 H402 V120" class="diagram__link diagram__link--soft"  marker-end="url(#ev-arrow)" />
    <text x="484" y="184" class="diagram__label">Regressions</text>
  </svg>
</DiagramFrame>
