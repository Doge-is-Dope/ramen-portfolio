---
import DiagramFrame from "./DiagramFrame.astro";

type Props = { caption: string };
const { caption } = Astro.props;
---

<DiagramFrame caption={caption} label="How browser tools reach Chrome — scroll horizontally on smaller screens">
  <svg class="diagram diagram--sequence" viewBox="0 0 640 496" role="img" aria-labelledby="br-title br-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="br-title">How browser tools reach Chrome</title>
    <desc id="br-desc">The browser subagent invokes the backend dispatcher. Calls cross a WebSocket to the frontend client, then Chrome runtime messages reach the service worker, which operates the controlled tab through CDP. Each result returns along the same path. The frontend owns the socket; the service worker owns local execution.</desc>
    <defs>
      <marker id="br-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M1,1 L9,5 L1,9" class="diagram__arrowhead" />
      </marker>
    </defs>
    <text x="128" y="28" class="diagram__group-title">Backend</text>
    <text x="448" y="28" class="diagram__group-title">User’s browser</text>
    <path d="M8 40 H248 M264 40 H632 M256 8 V484" class="diagram__lifeline" />
    <rect x="8" y="56" width="112" height="64" rx="8" class="diagram__node" />
    <text x="64" y="82" class="diagram__node-title">Browser agent</text>
    <text x="64" y="103" class="diagram__node-sub">browser_use</text>
    <path d="M64 128 V484" class="diagram__lifeline" />
    <rect x="136" y="56" width="112" height="64" rx="8" class="diagram__node" />
    <text x="192" y="82" class="diagram__node-title">Dispatcher</text>
    <text x="192" y="103" class="diagram__node-sub">Backend</text>
    <path d="M192 128 V484" class="diagram__lifeline" />
    <rect x="264" y="56" width="112" height="64" rx="8" class="diagram__node" />
    <text x="320" y="82" class="diagram__node-title">WS client</text>
    <text x="320" y="103" class="diagram__node-sub">Frontend</text>
    <path d="M320 128 V484" class="diagram__lifeline" />
    <rect x="392" y="56" width="112" height="64" rx="8" class="diagram__node" />
    <text x="448" y="82" class="diagram__node-title">Service worker</text>
    <text x="448" y="103" class="diagram__node-sub">Extension</text>
    <path d="M448 128 V484" class="diagram__lifeline" />
    <rect x="520" y="56" width="112" height="64" rx="8" class="diagram__node" />
    <text x="576" y="82" class="diagram__node-title">Controlled tab</text>
    <text x="576" y="103" class="diagram__node-sub">Chrome</text>
    <path d="M576 128 V484" class="diagram__lifeline" />
    <path d="M64 156 H192" class="diagram__link" marker-end="url(#br-arrow)" />
    <text x="128.0" y="144" class="diagram__label">1 · Tool call</text>
    <path d="M192 200 H320" class="diagram__link" marker-end="url(#br-arrow)" />
    <text x="256.0" y="188" class="diagram__label">2 · WS tool_call</text>
    <path d="M320 244 H448" class="diagram__link" marker-end="url(#br-arrow)" />
    <text x="384.0" y="232" class="diagram__label">3 · Chrome message</text>
    <path d="M448 288 H576" class="diagram__link" marker-end="url(#br-arrow)" />
    <text x="512.0" y="276" class="diagram__label">4 · CDP command</text>
    <path d="M576 336 H448" class="diagram__link diagram__link--soft" marker-end="url(#br-arrow)" />
    <text x="512.0" y="324" class="diagram__label">5 · CDP result</text>
    <path d="M448 380 H320" class="diagram__link diagram__link--soft" marker-end="url(#br-arrow)" />
    <text x="384.0" y="368" class="diagram__label">6 · Chrome response</text>
    <path d="M320 424 H192" class="diagram__link diagram__link--soft" marker-end="url(#br-arrow)" />
    <text x="256.0" y="412" class="diagram__label">7 · WS tool_result</text>
    <path d="M192 468 H64" class="diagram__link diagram__link--soft" marker-end="url(#br-arrow)" />
    <text x="128.0" y="456" class="diagram__label">8 · Tool result</text>
  </svg>
</DiagramFrame>
