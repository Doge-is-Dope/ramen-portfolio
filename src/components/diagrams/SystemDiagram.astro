---
import DiagramFrame from "./DiagramFrame.astro";

type Props = { caption: string };
const { caption } = Astro.props;
---

<DiagramFrame caption={caption} label="Where RAMEN runs — scroll horizontally on smaller screens">
  <svg class="diagram" viewBox="0 0 640 372" role="img" aria-labelledby="sys-title sys-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="sys-title">Where RAMEN runs</title>
    <desc id="sys-desc">The React client connects to the FastAPI agent backend over HTTP with SSE responses, or over WebSocket for chat and browser tools. In the local browser, the client relays actions to extension tools and the controlled tab. The backend uses supporting model, storage and authentication services.</desc>
    <defs>
      <marker id="sys-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M1,1 L9,5 L1,9" class="diagram__arrowhead" />
      </marker>
    </defs>
    <rect x="8" y="8" width="232" height="352" rx="8" class="diagram__group" />
    <text x="24" y="36" class="diagram__group-title diagram__anchor-start">User’s browser</text>
    <rect x="400" y="8" width="232" height="352" rx="8" class="diagram__group" />
    <text x="416" y="36" class="diagram__group-title diagram__anchor-start">Backend</text>
    <rect x="24" y="72" width="200" height="72" rx="8" class="diagram__node" />
    <text x="124.0" y="102" class="diagram__node-title">React client</text>
    <text x="124.0" y="125" class="diagram__node-sub">Chat interface</text>
    <rect x="24" y="264" width="200" height="72" rx="8" class="diagram__node" />
    <text x="124.0" y="294" class="diagram__node-title">Browser tools</text>
    <text x="124.0" y="317" class="diagram__node-sub">Extension + controlled tab</text>
    <rect x="416" y="72" width="200" height="72" rx="8" class="diagram__node" />
    <text x="516.0" y="102" class="diagram__node-title">Agent runtime</text>
    <text x="516.0" y="125" class="diagram__node-sub">FastAPI + LangGraph</text>
    <rect x="416" y="264" width="200" height="72" rx="8" class="diagram__node" />
    <text x="516.0" y="294" class="diagram__node-title">Supporting services</text>
    <text x="516.0" y="317" class="diagram__node-sub">Models · storage · auth</text>
    <path d="M232 96 H408" class="diagram__link" marker-start="url(#sys-arrow)" marker-end="url(#sys-arrow)" />
    <text x="320" y="83" class="diagram__label">HTTP / SSE</text>
    <path d="M232 128 H408" class="diagram__link" marker-start="url(#sys-arrow)" marker-end="url(#sys-arrow)" />
    <text x="320" y="154" class="diagram__label">WebSocket</text>
    <path d="M124 152 V256" class="diagram__link" marker-start="url(#sys-arrow)" marker-end="url(#sys-arrow)" />
    <rect x="64" y="191" width="120" height="28" class="diagram__label-bg" />
    <text x="124" y="210" class="diagram__label">Local messages</text>
    <path d="M516 152 V256" class="diagram__link" marker-start="url(#sys-arrow)" marker-end="url(#sys-arrow)" />
    <rect x="432" y="191" width="168" height="28" class="diagram__label-bg" />
    <text x="516" y="210" class="diagram__label">Requests / responses</text>
  </svg>
</DiagramFrame>
