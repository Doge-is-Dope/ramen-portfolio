---
import DiagramFrame from "./DiagramFrame.astro";

type Props = { caption: string };
const { caption } = Astro.props;
---

<DiagramFrame caption={caption} label="How backend responsibilities stay separate — scroll horizontally on smaller screens">
  <svg class="diagram" viewBox="0 0 640 402" role="img" aria-labelledby="be-title be-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="be-title">How backend responsibilities stay separate</title>
    <desc id="be-desc">Selected dependency arrows connect presentation to application and application to domain. Infrastructure implements domain contracts and uses application events. These are code dependencies, not an execution sequence. Concrete wiring is handled by AppContainer.</desc>
    <defs>
      <marker id="be-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M1,1 L9,5 L1,9" class="diagram__arrowhead" />
      </marker>
    </defs>
    <text x="320" y="24" class="diagram__label">Code dependencies</text>
    <rect x="24" y="48" width="256" height="72" rx="8" class="diagram__node" />
    <text x="152.0" y="78" class="diagram__node-title">Presentation</text>
    <text x="152.0" y="101" class="diagram__node-sub">HTTP · SSE · WebSocket</text>
    <rect x="24" y="180" width="256" height="72" rx="8" class="diagram__node" />
    <text x="152.0" y="210" class="diagram__node-title">Application</text>
    <text x="152.0" y="233" class="diagram__node-sub">ChatUseCase · events</text>
    <rect x="24" y="312" width="256" height="72" rx="8" class="diagram__node" />
    <text x="152.0" y="342" class="diagram__node-title">Domain</text>
    <text x="152.0" y="365" class="diagram__node-sub">Entities · contracts</text>
    <rect x="392" y="246" width="224" height="72" rx="8" class="diagram__node" />
    <text x="504.0" y="276" class="diagram__node-title">Infrastructure</text>
    <text x="504.0" y="299" class="diagram__node-sub">LangGraph · MongoDB</text>
    <path d="M152 128 V172" class="diagram__link"  marker-end="url(#be-arrow)" />
    <path d="M152 260 V304" class="diagram__link"  marker-end="url(#be-arrow)" />
    <path d="M504 238 V216 H288" class="diagram__link"  marker-end="url(#be-arrow)" />
    <text x="386" y="202" class="diagram__label">Uses events</text>
    <path d="M504 326 V348 H288" class="diagram__link"  marker-end="url(#be-arrow)" />
    <text x="392" y="375" class="diagram__label">Implements contracts</text>
  </svg>
</DiagramFrame>
