---
import DiagramFrame from "./DiagramFrame.astro";

type Props = { caption: string };
const { caption } = Astro.props;
---

<DiagramFrame caption={caption} label="One stream from agent to chat — scroll horizontally on smaller screens">
  <svg class="diagram" viewBox="0 0 640 196" role="img" aria-labelledby="rt-title rt-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="rt-title">One stream from agent to chat</title>
    <desc id="rt-desc">A chat request travels from the client through ChatUseCase to the agent runtime over HTTP or WebSocket. Runtime output is translated and serialized as shared application events. SSE or WebSocket carries those events back to the client, which assembles and renders the conversation.</desc>
    <defs>
      <marker id="rt-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M1,1 L9,5 L1,9" class="diagram__arrowhead" />
      </marker>
    </defs>
    <rect x="8" y="88" width="168" height="72" rx="8" class="diagram__node" />
    <text x="92.0" y="118" class="diagram__node-title">Agent runtime</text>
    <text x="92.0" y="141" class="diagram__node-sub">LangGraph</text>
    <rect x="240" y="88" width="168" height="72" rx="8" class="diagram__node" />
    <text x="324.0" y="118" class="diagram__node-title">Shared events</text>
    <text x="324.0" y="141" class="diagram__node-sub">Translate + serialize</text>
    <rect x="472" y="88" width="160" height="72" rx="8" class="diagram__node" />
    <text x="552.0" y="118" class="diagram__node-title">Chat UI</text>
    <text x="552.0" y="141" class="diagram__node-sub">Assemble + render</text>
    <path d="M552 80 V32 H92 V80" class="diagram__link"  marker-end="url(#rt-arrow)" />
    <text x="320" y="22" class="diagram__label">Chat request · HTTP / WebSocket</text>
    <path d="M184 124 H232" class="diagram__link"  marker-end="url(#rt-arrow)" />
    <text x="208" y="111" class="diagram__label">Events</text>
    <path d="M416 124 H464" class="diagram__link"  marker-end="url(#rt-arrow)" />
    <text x="440" y="111" class="diagram__label">SSE / WS</text>
  </svg>
</DiagramFrame>
