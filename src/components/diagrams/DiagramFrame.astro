---
import InlineText from "@/components/InlineText.astro";

type Props = {
	caption: string;
	label: string;
};
const { caption, label } = Astro.props;
---

<figure class="diagram-figure">
  <p class="diagram-scroll-hint" hidden>Scroll horizontally to follow the full diagram →</p>
  <div class="diagram-scroll" role="region" aria-label={label} tabindex="0">
    <slot />
  </div>
  <figcaption class="diagram-figure__caption">
    <InlineText text={caption} />
  </figcaption>
</figure>

<script>
  import { initOnce } from "@/lib/init-once";

  initOnce("diagramOverflow", () => {
    let observer: ResizeObserver | undefined;

    const setup = () => {
      observer?.disconnect();
      const regions = document.querySelectorAll<HTMLElement>(".diagram-scroll");
      const update = () => {
        for (const region of regions) {
          const diagram = region.querySelector("svg");
          if (diagram) {
            const width = diagram.getBoundingClientRect().width;
            if (width > 0) {
              diagram.style.setProperty(
                "--diagram-text-scale",
                String(diagram.viewBox.baseVal.width / width),
              );
            }
          }
          const hint = region.previousElementSibling;
          if (hint instanceof HTMLElement) {
            hint.hidden = region.scrollWidth <= region.clientWidth;
          }
        }
      };

      observer = new ResizeObserver(update);
      for (const region of regions) {
        observer.observe(region);
        const diagram = region.querySelector("svg");
        if (diagram) observer.observe(diagram);
      }
      update();
    };

    document.addEventListener("astro:before-swap", () => observer?.disconnect());
    document.addEventListener("astro:page-load", setup);
    setup();
  });
</script>
